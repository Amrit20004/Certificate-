# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextute_certs?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# Public base URL. Used to build the QR verification link that is burned into
# every PDF, so changing it later will NOT update already-issued certificates.
NEXT_PUBLIC_APP_URL="https://certificates.nextute.com"

# Storage driver: "local" (dev) or "s3"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed account (first Super Admin)
SEED_ADMIN_EMAIL="admin@nextute.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Nextute Admin"
